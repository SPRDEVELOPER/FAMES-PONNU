# ── required ───────────────────────────────
BOT_TOKEN=
MONGODB_URI=mongodb://127.0.0.1:27017/flamesbot
# one or more Telegram user IDs, comma separated (e.g. 123456789,987654321)
ADMIN_ID=
# bot username without @ (optional - auto-detected if empty)
BOT_USERNAME=

# ── webhook mode (leave empty to use long polling) ──
# public https URL of your deployment, e.g. https://flames-bot.onrender.com
WEBHOOK_URL=
# optional secret (A-Z a-z 0-9 _ -). auto-derived from BOT_TOKEN if empty
WEBHOOK_SECRET=
PORT=3000

# ── tuning (optional) ──────────────────────
GAME_COOLDOWN_SECONDS=5
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=10

# ── optional image overrides (public https image URLs) ──
# IMG_DEFAULT=
# IMG_WELCOME=
# IMG_PLAY=
# IMG_HELP=
# IMG_STATS=
# IMG_LEADERBOARD=
# IMG_RESULT_F=
# IMG_RESULT_L=
# IMG_RESULT_A=
# IMG_RESULT_M=
# IMG_RESULT_E=
# IMG_RESULT_S=
